# Catch-all deny for the whole tools/ tree.
#
# Each subfolder carries its own copy of this rule, but those were added one at
# a time as each toolset was written - and a folder added without one was served
# over HTTP, including a backup JSON containing a full page's content and meta.
# This file makes deny the default for anything added under tools/ from now on,
# so the per-folder copies are a second layer rather than the only guard.
#
# Everything here is a CLI utility. Nothing under tools/ is ever requested by a
# browser, so denying the whole tree costs nothing.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
