# These tools are command-line utilities. Nothing here should ever be reachable
# over HTTP. Every script also refuses to run outside the CLI SAPI, so this is a
# second layer rather than the only guard.
#
# dumps/ describes the site's Elementor configuration, plugin versions and
# template inventory. Harmless to us, useful to someone probing the site.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
