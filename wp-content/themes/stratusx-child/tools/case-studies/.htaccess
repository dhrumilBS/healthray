# These tools are command-line utilities. Nothing here should ever be reachable
# over HTTP. The PHP importer also refuses to run outside the CLI SAPI, so this
# is a second layer rather than the only guard.

<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
